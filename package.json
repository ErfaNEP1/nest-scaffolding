{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{PROJECT_NAME}} backend service",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "nest start --watch --builder swc --exec \"node --env-file-if-exists=.env\"",
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --project unit --coverage",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm test:int",
    "db:migrate": "docker compose run --rm migrate",
    "db:status": "docker compose run --rm migrate --status",
    "db:new": "bash db/new-migration.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-boundaries": "7.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/typeorm": "12.0.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "uuid": "14.0.3",
    "zod": "4.6.5"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
