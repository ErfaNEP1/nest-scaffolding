# Local development settings. Copy to .env: cp .env.example .env
# Every variable is described in docs/operations/configuration.md.
# Values here are safe local defaults; never put real secrets in this file.

# --- app ---
NODE_ENV=development
APP_NAME={{PROJECT_NAME}}
# Set by the image build (Dockerfile build args); set here only to override.
# APP_VERSION=0.0.0
# APP_COMMIT=local
SHUTDOWN_TIMEOUT_MS=15000

# --- http ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
HTTP_CORS_ORIGINS=http://localhost:5173
HTTP_BODY_LIMIT=1mb
HTTP_TRUST_PROXY=false
DOCS_ENABLED=true

# --- database ---
# Docker Compose maps PostgreSQL to POSTGRES_PORT on localhost.
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgres://app:app@localhost:5432/app
# Used only by db/migrate.sh. Point it at a role with DDL rights; falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://app:app@localhost:5432/app
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# --- auth (Keycloak from `docker compose --profile auth up`) ---
KEYCLOAK_PORT=8080
OIDC_ISSUER_URL=http://localhost:8080/realms/dev
OIDC_AUDIENCE=api
# OIDC_JWKS_URL=http://localhost:8080/realms/dev/protocol/openid-connect/certs
OIDC_ROLES_CLAIM_PATH=realm_access.roles
OIDC_ALGORITHMS=RS256
OIDC_CLOCK_TOLERANCE_SEC=5

# --- jobs ---
JOBS_AUTO_MIGRATE=true
JOBS_SCHEMA=pgboss
JOBS_RETRY_LIMIT=3
JOBS_RETRY_DELAY_SEC=5
JOBS_RETRY_BACKOFF=true
JOBS_EXPIRE_SEC=900
JOBS_CONCURRENCY=5
JOBS_QUEUE_DEPTH_INTERVAL_SEC=15
WORKER_HTTP_PORT=3001

# --- logging ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- telemetry ---
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9464
WORKER_METRICS_PORT=9465
OTEL_SERVICE_NAME={{PROJECT_NAME}}
# Set to send traces and metrics with OTLP/HTTP, for example http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1
OTEL_METRIC_EXPORT_INTERVAL=60000
